VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Never put service_role, secret API keys, payment secrets or AI provider keys in VITE_ variables.
\n# Supabase Vercel integration aliases are supported by vite.config.ts:\n# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_PUBLISHABLE_KEY\n